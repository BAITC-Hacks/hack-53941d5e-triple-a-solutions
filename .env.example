# Copy this file to .env.local and fill values locally. Never commit real keys.
OPENAI_API_KEY=
# Node server reads .env.local; values already present in the environment take priority.
# Keep disabled until the endpoint and dataset use are approved for this hackathon.
AI_ENABLED=false
AI_DATA_APPROVED=false
# Set an accessible model supporting Responses API + strict JSON Schema.
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=8000

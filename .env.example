# Copy to .env.local if it does not exist. The only required setting is the key.
# Adding a key enables requests to OpenAI for profile-derived and aggregate data.
# Use an endpoint permitted by the hackathon rules. Never commit real keys.
OPENAI_API_KEY=
# Defaults are ready; uncomment only if needed. The server rereads this file live.
# AI_MODEL=gpt-4.1-mini
# AI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_MS=8500
# AI_ENABLED=false
